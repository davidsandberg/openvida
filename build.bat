@echo off
setlocal
cd /d "%~dp0"

set "CSC=C:\Windows\Microsoft.NET\Framework\v4.0.30319\csc.exe"
set "DIAG_DIR=%~dp0VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics"
set "SRC_DIR=%~dp0src"
set "ICON=%~dp0assets\vida_icon.ico"
set "VERSION_FILE=%~dp0VERSION"

set "APP_VER=1.0.0"
if exist "%VERSION_FILE%" (
    for /f "usebackq tokens=*" %%v in ("%VERSION_FILE%") do set "APP_VER=%%v"
)
set "APP_VER=%APP_VER: =%"
if "%APP_VER:~0,1%"=="v" set "APP_VER=%APP_VER:~1%"
if "%APP_VER:~0,1%"=="V" set "APP_VER=%APP_VER:~1%"
set "APP_TAG=v%APP_VER%"

echo ============================================================
echo   Building OpenVIDA Standalone Diagnostics (%APP_TAG%)
echo ============================================================

(
echo // Auto-generated by build.bat from repo root VERSION file.
echo using System.Reflection;
echo.
echo [assembly: AssemblyVersion("%APP_VER%.0"^)]
echo [assembly: AssemblyFileVersion("%APP_VER%.0"^)]
echo [assembly: AssemblyInformationalVersion("%APP_VER%"^)]
echo.
echo public static class AppVersion
echo {
echo     public const string Version = "%APP_VER%";
echo     public const string Tag = "%APP_TAG%";
echo     public const string DisplayName = "OpenVIDA %APP_TAG%";
echo     public const string Title = "OpenVIDA %APP_TAG% Standalone Diagnostics";
echo }
) > "%SRC_DIR%\Core\VersionInfo.cs"

if exist "%ICON%" (
    copy /y "%ICON%" "%DIAG_DIR%\vida_icon.ico" >nul
)

pushd "%DIAG_DIR%"

echo [1/4] Compiling DummyIsoView.dll (CGM Vector Network Renderer)...
"%CSC%" /nologo /platform:x86 /target:library ^
    /out:DummyIsoView_new.dll ^
    /r:Interop.ISOVIEWXLib.dll ^
    /r:System.Windows.Forms.dll ^
    /r:System.Drawing.dll ^
    "%SRC_DIR%\IsoView\DummyIsoView.cs"
if errorlevel 1 (
    echo [ERROR] DummyIsoView.dll compilation failed!
    popd
    exit /b 1
)
move /y DummyIsoView_new.dll DummyIsoView.dll >nul 2>&1

echo [2/4] Compiling VidaLauncher.exe from modular src\ files...
"%CSC%" /nologo /platform:x86 /target:exe /win32icon:vida_icon.ico ^
    /out:VidaLauncher_new.exe ^
    /r:UI.dll ^
    /r:Core.dll ^
    /r:Workflow.dll ^
    /r:Util.dll ^
    /r:ValueObjects.dll ^
    /r:System.Windows.Forms.DataVisualization.dll ^
    /r:DummyIsoView.dll ^
    /r:GuiComponents.dll ^
    /r:ProgressHandler.dll ^
    /r:System.IO.Compression.dll ^
    /r:System.IO.Compression.FileSystem.dll ^
    /r:System.Data.dll ^
    /r:System.Web.Extensions.dll ^
    /r:Microsoft.Web.WebView2.WinForms.dll ^
    /r:Microsoft.Web.WebView2.Core.dll ^
    /r:BizServices.Scripting.dll ^
    /r:AppServices.Scripting.dll ^
    "%SRC_DIR%\Program.cs" ^
    "%SRC_DIR%\Core\*.cs" ^
    "%SRC_DIR%\Hardware\*.cs" ^
    "%SRC_DIR%\Diagnostics\*.cs" ^
    "%SRC_DIR%\Documents\*.cs" ^
    "%SRC_DIR%\Tabs\*.cs" ^
    "%SRC_DIR%\Testing\*.cs"
if errorlevel 1 (
    echo [ERROR] VidaLauncher.exe compilation failed!
    popd
    exit /b 1
)
move /y VidaLauncher_new.exe VidaLauncher.exe >nul 2>&1
if errorlevel 1 (
    echo [INFO] VidaLauncher.exe is currently running. Stopping running instance to update binary...
    taskkill /f /im VidaLauncher.exe >nul 2>&1
    powershell -NoProfile -Command "Start-Sleep -Milliseconds 800"
    move /y VidaLauncher_new.exe VidaLauncher.exe >nul 2>&1
    if errorlevel 1 (
        echo [ERROR] Could not overwrite VidaLauncher.exe. Please close any running instance!
        popd
        exit /b 1
    )
)
popd

echo [3/4] Compiling VidaMcp.exe (MCP Bridge)...
pushd "%~dp0mcp\vida-mcp"
"%CSC%" /nologo /platform:x86 /target:exe ^
    /out:VidaMcp_new.exe ^
    /r:System.Web.Extensions.dll ^
    /r:System.Data.dll ^
    /r:System.IO.Compression.dll ^
    /r:System.IO.Compression.FileSystem.dll ^
    /r:System.Web.dll ^
    VidaMcp.cs ^
    "%SRC_DIR%\Core\VersionInfo.cs"
if not errorlevel 1 (
    move /y VidaMcp_new.exe VidaMcp.exe >nul 2>&1
    if errorlevel 1 (
        taskkill /f /im VidaMcp.exe >nul 2>&1
        powershell -NoProfile -Command "Start-Sleep -Milliseconds 400"
        move /y VidaMcp_new.exe VidaMcp.exe >nul 2>&1
    )
)
popd

echo [4/4] Packaging Payload ^& Compiling OpenVidaSetup.exe (Standalone Installer)...
if exist "%~dp0OpenVidaPayload.zip" del /f /q "%~dp0OpenVidaPayload.zip" >nul 2>&1
"%~dp0tools\7z.exe" a -tzip "%~dp0OpenVidaPayload.zip" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\VidaLauncher.exe" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\DummyIsoView.dll" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\Microsoft.Web.WebView2.Core.dll" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\Microsoft.Web.WebView2.WinForms.dll" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\WebView2Loader.dll" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\components.config.xml" ^
    "VIDA\jboss\standalone\deployments\VidaEar.ear\VidaWeb.war\Diagnostics\vida_icon.ico" ^
    "VIDA\commToolInformation.xml" ^
    "mcp\vida-mcp\VidaMcp.exe" ^
    "assets\vida_icon.ico" ^
    "assets\ewd_nav_index.zip" ^
    "VERSION" ^
    "tools\7z.exe" ^
    "tools\7z.dll" ^
    "DiCE\Tools\*" ^
    "run_diagnostics.bat" ^
    "Vida.bat" ^
    "restart_sql.bat" ^
    "enable_sql_tcp.bat" ^
    "repair_sql_users.ps1" ^
    "pack_data.bat" >nul

"%CSC%" /nologo /platform:anycpu /target:winexe /win32icon:"%ICON%" ^
    /out:"%~dp0OpenVidaSetup.exe" ^
    /resource:"%~dp0OpenVidaPayload.zip",OpenVidaPayload.zip ^
    /r:System.Windows.Forms.dll ^
    /r:System.Drawing.dll ^
    /r:System.Data.dll ^
    /r:System.ServiceProcess.dll ^
    /r:System.IO.Compression.dll ^
    /r:System.IO.Compression.FileSystem.dll ^
    "%SRC_DIR%\Installer\OpenVidaSetup.cs" ^
    "%SRC_DIR%\Core\VersionInfo.cs"
if errorlevel 1 (
    echo [ERROR] OpenVidaSetup.exe compilation failed!
    if exist "%~dp0OpenVidaPayload.zip" del /f /q "%~dp0OpenVidaPayload.zip" >nul 2>&1
    exit /b 1
)
if exist "%~dp0OpenVidaPayload.zip" del /f /q "%~dp0OpenVidaPayload.zip" >nul 2>&1

echo.
echo ============================================================
echo   BUILD COMPLETED SUCCESSFULLY!
echo ============================================================
echo OpenVIDA Diagnostics: %DIAG_DIR%\VidaLauncher.exe
echo OpenVIDA MCP Bridge:  %~dp0mcp\vida-mcp\VidaMcp.exe
echo OpenVIDA Installer:   %~dp0OpenVidaSetup.exe
echo ============================================================
exit /b 0
